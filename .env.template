## Directory to store GTFS information
GTFS_DIR=lib/gtfs
## Refresh rate in ms to update GTFS RealTime information during runtime
GTFS_REFRESH_RATE=30000 # 30s
## Random variation applied to each GTFS Realtime refresh to avoid synchronization with the provider
GTFS_REFRESH_JITTER=5000 # +/- 5s
## Delay before retrying a partial GTFS Realtime feed
GTFS_RT_RETRY_DELAY=7000 # 7s
## Refresh rate in ms to update GTFS Static  information during runtime
GTFS_STATIC_REFRESH_RATE=14400000 # 4 hours
## Realtime StopTimes CACHE, disabled by default
GTFS_RT_CACHE=False
## Seconds to refresh the cache on GTFS Realtime data
GTFS_RT_CACHE_EXPIRE=20 # 20s
## Seconds to retain imported GTFS Realtime records when the upstream feed is empty or incomplete
GTFS_RT_EXPIRATION_SECONDS=180 # 3 minutes
## Disable GTFS Static download and use local files
GTFS_STATIC_DISABLE_DOWNLOAD=false
